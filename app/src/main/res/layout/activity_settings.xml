<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_worker_url"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_worker_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/worker_url_hint"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/worker_url_info" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_allowlist"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_allowlist"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/allowlist_info" />

        <TextView
            android:id="@+id/observed_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/observed_hint"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/observed_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_device_id"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_device_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_copy_device_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_copy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_hmac_secret"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_hmac_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/secret_hidden"
            android:textIsSelectable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_show_secret"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_show" />

            <Button
                android:id="@+id/btn_copy_secret"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_copy" />

            <Button
                android:id="@+id/btn_regenerate_secret"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_regenerate" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save" />

    </LinearLayout>
</ScrollView>
